{
  "name": "canker-core",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "cap:add:ios": "cap add ios --packagemanager CocoaPods && npm run cap:patch",
    "cap:add:android": "cap add android && npm run cap:patch",
    "cap:sync": "cap sync && npm run cap:patch",
    "cap:patch": "node scripts/patch-native.mjs",
    "cap:assets": "node scripts/generate-app-icons.mjs && capacitor-assets generate --ios --android --iconBackgroundColor '#4B4BF0' --iconBackgroundColorDark '#4B4BF0' --splashBackgroundColor '#4A52F1' --splashBackgroundColorDark '#0F1033'",
    "cap:ios": "cap sync ios && npm run cap:patch && cap open ios",
    "cap:android": "cap sync android && npm run cap:patch && cap open android",
    "prettier-fix": "prettier --write .",
    "db:schema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f schema.sql",
    "db:funnel": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/funnel.sql",
    "test": "vitest run",
    "test:dst": "TZ=America/Los_Angeles vitest run utils/dst.test.ts",
    "art:kanko": "node tools/kanko-assets.mjs",
    "art:lab": "node tools/style-lab.mjs",
    "art:review": "node tools/review-page.mjs --all --serve"
  },
  "dependencies": {
    "@canker-core/fold": "file:native/plugins/fold",
    "@canker-core/web-auth": "file:native/plugins/web-auth",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-health": "^8.11.14",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.6",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@types/mdx": "^2.0.14",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "0.469.0",
    "next": "16.3.6",
    "next-themes": "^0.4.4",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "^1.1.18"
    }
  }
}

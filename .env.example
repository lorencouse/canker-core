# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (self-hosted Postgres)
# ---------------------------------------------------------------------------
# Local dev:  postgresql://postgres@127.0.0.1:5432/canker
# Production: the connection string from the Coolify Postgres service
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/canker
# Set to "true" when the Postgres server terminates TLS (Coolify does).
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 32
# Changing this invalidates every existing session.
BETTER_AUTH_SECRET=

# OAuth providers. Callback URL to register with each provider:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/callback/github
#   <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email (SMTP) — magic links, password resets, email verification
# ---------------------------------------------------------------------------
# Same approach as maleq-headless: an existing mailbox, no paid email service.
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Canker Core <no-reply@cankercore.com>
# Without SMTP credentials the app logs auth emails to the server console
# instead of sending them, which is fine for local development.
